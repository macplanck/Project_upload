.PHONY: mem_init mem_test mem_func LUT_init

######################################
# Set your desired file names
######################################
#-------------- MEM --------------
path_mem = A4_MEM/A0_MEM

######################################
# Default Setting
######################################


######################################
# Simulation Option and Command
######################################

# =====================================
# ============== MEM ==================
# =====================================

MEM_INIT = python3 ${path_mem}/../A1_INIT/${MEM}.py \
	--fill ${FILL} \
	--XLEN ${XLEN} \
	--YLEN ${YLEN} \
	--LNUM ${LNUM} \
	--name ${NAME}

MEM_TEST = python3 ${path_mem}/../A0_MEM/${MEM}.py
MEM_FUNC = python3 ${path_mem}/../A3_TEST/${MEM}.py

LUT_INIT = python3 ${path_mem}/../A1_INIT/${LUT}.py \
	--LNUM ${LNUM} \
	--name ${NAME}

# =====================================
mem_init:
	cd ..  &&  ${MEM_INIT}

mem_test:
	cd ..  &&  ${MEM_TEST}

mem_func:
	cd ..  &&  ${MEM_FUNC}

LUT_init:
	cd ..  &&  ${LUT_INIT}